{
    "name": "jul6art/auth-bundle",
    "type": "symfony-bundle",
    "description": "Symfony auth bundle",
    "homepage": "https://github.com/jul6art/auth-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jul6Art",
            "email": "admin@devinthehood.com",
            "homepage": "https://devinthehood.com/"
        }
    ],
    "require": {
        "php": "^8.5",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.5.3",
        "doctrine/persistence": "^3.4.5 || ^4.0",
        "jul6art/core-bundle": "^2.3 || ^3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "api-platform/core": "^5.0",
        "endroid/qr-code": "^6.2",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "gesdinet/jwt-refresh-token-bundle": "^2.3",
        "lexik/jwt-authentication-bundle": "^3.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^13.4.5",
        "rector/rector": "^2.8.3",
        "scheb/2fa-backup-code": "^8.7",
        "scheb/2fa-bundle": "^8.7",
        "scheb/2fa-totp": "^8.7",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/event-dispatcher-contracts": "^2.5.4 || ^3.0",
        "symfony/expression-language": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/mailer": "^7.4 || ^8.0",
        "symfony/phpunit-bridge": "^7.4 || ^8.0",
        "symfony/rate-limiter": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/serializer": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "symfony/var-dumper": "^7.4 || ^8.0",
        "symfonycasts/reset-password-bundle": "^1.26"
    },
    "conflict": {
        "symfony/translation-contracts": "<3.5"
    },
    "suggest": {
        "api-platform/core": "The API sign-in (auth.api): its routes are API Platform resources",
        "endroid/qr-code": "The API sign-in (auth.api): the QR code of the second factor",
        "gesdinet/jwt-refresh-token-bundle": "The API sign-in (auth.api): the refresh token, one table per realm",
        "lexik/jwt-authentication-bundle": "The API sign-in (auth.api): the access token and its cookie",
        "scheb/2fa-backup-code": "The API sign-in (auth.api): the backup codes",
        "scheb/2fa-bundle": "The API sign-in (auth.api): the second factor",
        "scheb/2fa-totp": "The API sign-in (auth.api): the authenticator app",
        "symfony/clock": "The API sign-in (auth.api): the clock of the TOTP",
        "symfony/expression-language": "The API sign-in (auth.api): the access decisions of its routes",
        "symfony/mailer": "The API sign-in (auth.api): the forgotten-password e-mail",
        "symfony/rate-limiter": "The sign-in limiter (auth.sign_in_throttling), and the budget of wrong codes of the API sign-in (auth.api)",
        "symfony/security-bundle": "The API sign-in (auth.api): the firewalls",
        "symfony/twig-bundle": "The API sign-in (auth.api): the e-mail templates",
        "symfonycasts/reset-password-bundle": "The API sign-in (auth.api): the forgotten password, one table per realm"
    },
    "autoload": {
        "psr-4": {
            "Jul6Art\\AuthBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Jul6Art\\AuthBundle\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "test": "phpunit",
        "qa": [
            "@cs-check",
            "@rector-check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "cs": "Fix the coding style with PHP-CS-Fixer",
        "cs-check": "Report coding style violations without writing",
        "phpstan": "Run the static analysis",
        "rector": "Apply the Rector rule sets",
        "rector-check": "Report Rector changes without writing",
        "test": "Run the PHPUnit test suite",
        "qa": "Run the whole quality gate (style, Rector, static analysis, tests)"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "symfony": {
            "require": "7.4.*"
        }
    }
}
