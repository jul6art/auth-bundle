{# The "forgot password" e-mail of the API sign-in, in the account's language (TemplatedEmail::locale). #}
{% trans_default_domain 'auth_emails' %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ 'password_reset.subject'|trans({'%app%': app}) }}</title>
</head>
<body>
    <p>{{ 'password_reset.greeting'|trans({'%name%': name}) }}</p>
    <p>{{ 'password_reset.intro'|trans({'%app%': app}) }}</p>
    <p><a href="{{ link }}">{{ 'password_reset.action'|trans }}</a></p>
    <p>{{ 'password_reset.expiry'|trans }}</p>
    <p>{{ 'password_reset.ignore'|trans }}</p>
    <p>— {{ app }}</p>
</body>
</html>
